# ===================== #
#    Java Build Files   #
# ===================== #
target/
*.class
*.jar
*.war
*.ear

# ===================== #
#     Maven Wrapper     #
# ===================== #
!mvnw
!mvnw.cmd
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties
!.mvn/wrapper/maven-wrapper-downloader.jar

# ===================== #
#   IntelliJ IDEA Files #
# ===================== #

# Ignore all .idea files except those useful for project configuration
.idea/
!.idea/codeStyles/
!.idea/misc.xml
!.idea/modules.xml

# Ignore user-specific and volatile IntelliJ files
.idea/workspace.xml
.idea/usage.statistics.xml
.idea/dictionaries
*.iml

