<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<AnchorPane prefWidth="1280" prefHeight="720"
            xmlns="http://javafx.com/javafx/17.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.quizez.quizCreateControllers.CreateQuizController2">

   <children>
      <StackPane AnchorPane.topAnchor="0.0"
                 AnchorPane.bottomAnchor="0.0"
                 AnchorPane.leftAnchor="0.0"
                 AnchorPane.rightAnchor="0.0">

         <VBox alignment="CENTER" spacing="15" maxWidth="600" prefWidth="600" style="-fx-background-color: transparent;">

            <Label fx:id="WarningLabel" text="Dodaj przynajmniej jedno pytanie, aby kontynuować"
                   visible="false" style="-fx-text-fill: red;"/>

            <TextArea fx:id="QuestionTextArea" prefHeight="100" prefWidth="600"
                      wrapText="true" promptText="Wpisz treść pytania" />

            <Button fx:id="AddMoreAnswsersButton" mnemonicParsing="false"
                    onAction="#onAddMoreAnswsersButtonClick" text="Dodaj odpowiedź" maxWidth="200"/>

            <VBox fx:id="answersContainer" spacing="5" prefWidth="600" />

            <HBox spacing="20" alignment="CENTER">
               <Button fx:id="SaveQuizButton" mnemonicParsing="false"
                       onAction="#onSaveQuestionButtonClick" text="Zapisz pytanie" maxWidth="200"/>
               <Button fx:id="GoToSummaryButton" mnemonicParsing="false"
                       onAction="#onGoToSummaryButtonClick" text="Podsumowanie" maxWidth="200"/>
            </HBox>

         </VBox>
      </StackPane>
   </children>

</AnchorPane>


