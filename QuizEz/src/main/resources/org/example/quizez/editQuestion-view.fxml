<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefWidth="1280" prefHeight="720"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.quizez.editControllers.EditQuestionController">

    <children>
        <StackPane AnchorPane.topAnchor="0.0"
                   AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0">

            <HBox spacing="20" maxWidth="720" prefWidth="720" alignment="CENTER">

                <ListView fx:id="questionsListView" prefWidth="200" prefHeight="500" />

                <VBox spacing="10" prefWidth="500" alignment="TOP_LEFT">

                    <Label text="Treść pytania:"/>
                    <TextArea fx:id="questionTextArea" prefHeight="100" wrapText="true" />

                    <Label text="Odpowiedzi:"/>
                    <VBox fx:id="answersContainer" spacing="5" />

                    <HBox spacing="10">
                        <Button text="Dodaj odpowiedź" onAction="#onAddAnswer" />
                        <Button text="Zapisz pytanie" onAction="#onSaveQuestion" />
                    </HBox>


                </VBox>

            </HBox>

        </StackPane>
        <Button fx:id="ReturnButton" mnemonicParsing="false" onAction="#onReturnButtonClick" text="Wróć" maxWidth="100" />

    </children>
</AnchorPane>
