<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane  prefWidth="1280" prefHeight="720" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.quizez.CreateQuizSummaryController">
   <children>
      <ListView fx:id="questionListView" layoutX="46.0" layoutY="100.0" prefHeight="200.0" prefWidth="508.0" />
      <Button fx:id="SaveQuizDataButton" layoutX="478.0" layoutY="335.0" mnemonicParsing="false" onAction="#onSaveQuizDataButton" text="Zapisz quiz" />
      <Label fx:id="NameLabel" layoutX="37.0" layoutY="21.0" prefHeight="26.0" prefWidth="234.0" text="Nazwa:" />
      <Label fx:id="CategoryLabel" layoutX="37.0" layoutY="41.0" prefHeight="26.0" prefWidth="234.0" text="Kategoria:" />
      <Label fx:id="DifficultyLabel" layoutX="37.0" layoutY="61.0" prefHeight="26.0" prefWidth="234.0" text="Poziom trudności:" />
      <Label fx:id="TimeLabel" layoutX="347.0" layoutY="21.0" prefHeight="26.0" prefWidth="155.0" text="Limit czasowy:" />
      <Button fx:id="ReturnButton" layoutX="46.0" layoutY="329.0" mnemonicParsing="false" onAction="#onReturnButtonClick" text="Wróć do menu" />
   </children>
</AnchorPane>
