      <Label layoutX="147.0" layoutY="57.0" text="Gratulacje twój wynik to:">
         <font>
            <Font size="22.0" />
         </font>
      </Label>
      <Label fx:id="answered" layoutX="385.0" layoutY="57.0" text="X/Y">
         <font>
            <Font size="22.0" />
         </font>
      </Label>
      <Label fx:id="answeredPercent" layoutX="254.0" layoutY="107.0" text="X/Y%">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
