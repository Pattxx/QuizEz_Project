<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefWidth="1280" prefHeight="720" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.quizez.ResultController">
   <children>
      <Label layoutX="490.0" layoutY="150.0" text="Gratulacje twój wynik to:">
         <font>
            <Font size="22.0" />
         </font>
      </Label>
      <Label fx:id="answered" layoutX="750.0" layoutY="150.0" text="X/Y">
         <font>
            <Font size="22.0" />
         </font>
      </Label>
      <Label fx:id="answeredPercent" layoutX="590.0" layoutY="200.0" text="X/Y%">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <Button layoutX="540.0" layoutY="280.0" mnemonicParsing="false" prefHeight="48.0" prefWidth="200.0" text="Zagraj Ponownie" onAction="#onRepeatClick"/>
      <Button layoutX="510.0" layoutY="340.0" mnemonicParsing="false" prefHeight="67.0" prefWidth="260.0" text="Powrót do ekranu głównego" onAction="#onMainMenuClick" />
   </children>
</AnchorPane>

