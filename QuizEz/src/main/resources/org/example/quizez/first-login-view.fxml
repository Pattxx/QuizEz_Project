<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.quizez.loginControllers.FirstLoginController"
            prefWidth="1280" prefHeight="720"
>

    <children>
        <VBox alignment="CENTER" spacing="10" AnchorPane.topAnchor="20.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0">

            <!-- logo -->
            <ImageView fitWidth="250" preserveRatio="true" >
                <image>
                    <Image url="@images/QuizEzLogo.png" />
                </image>
            </ImageView>


            <Region prefHeight="20" />

            <Label text="Zaloguj się na konto" style="-fx-font-size: 18px;"/>
            <TextField fx:id="UsernameInputField" promptText="Nazwa użytkownika" maxWidth="300"/>
            <PasswordField fx:id="PasswordInputField" promptText="Hasło" maxWidth="300"/>
            <CheckBox fx:id="IsGuestCheckBox" text="Używaj jako gość" onAction="#onIsGuestCheckBoxClick"/>
            <Button fx:id="LogInButton" text="Zaloguj" onAction="#onLogInButtonClick" maxWidth="150"/>
            <Label text="Nie masz konta? Stwórz nowe!"/>
            <Button fx:id="RegisterViewButton" text="Zarejestruj" onAction="#onRegisterViewButtonClick" maxWidth="150"/>
            <Label fx:id="ErrorLabel" text="Błąd logowania" textFill="RED" visible="false"/>
        </VBox>
    </children>
</AnchorPane>
