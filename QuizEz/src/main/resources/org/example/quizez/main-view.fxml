<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SplitMenuButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane  prefWidth="1280" prefHeight="720" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.quizez.MainController" stylesheets="@../../../css/style.css" >
   <children>
      <SplitMenuButton fx:id="Profil" layoutX="440.0" layoutY="2.0" mnemonicParsing="false" onAction="#onButtonClick" prefHeight="31.0" prefWidth="185.0" text="Profil Użytkownika">
        <items>
          <MenuItem fx:id="Wyloguj" onAction="#onWyloguj" mnemonicParsing="false" text="Wyloguj" />
            <MenuItem fx:id="Zaloguj" onAction="#onLoginClick" mnemonicParsing="false" text="Zaloguj" />
            <MenuItem fx:id="Zarejestruj" onAction="#onRegisterClick" mnemonicParsing="false" text="Zarejestruj" />
        </items>
      </SplitMenuButton>
      <ImageView fx:id="Logo" fitHeight="78.0" fitWidth="104.0" layoutX="261.0" layoutY="9.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../images/c229230a3b2c48a1431890278087c095.jpg" />
         </image>
      </ImageView>
      <VBox alignment="CENTER" layoutX="145.0" layoutY="107.0" prefHeight="236.0" prefWidth="313.0">
         <children>
            <Button fx:id="Kategorie" mnemonicParsing="false" onAction="#onButtonClick" prefHeight="51.0" prefWidth="205.0" text="Kategorie quizu">
               <VBox.margin>
                  <Insets bottom="20.0" />
               </VBox.margin>
            </Button>
            <Button fx:id="utworzQuiz" mnemonicParsing="false" onAction="#onButtonClick" prefHeight="51.0" prefWidth="205.0" text="Utwórz quiz">
               <VBox.margin>
                  <Insets bottom="20.0" />
               </VBox.margin>
            </Button>
            <Button fx:id="twojeQuizy" mnemonicParsing="false" onAction="#onButtonClick" prefHeight="51.0" prefWidth="205.0" text="Twoje quizy" />
         </children></VBox>
      <ImageView fx:id="Icon" fitHeight="51.0" fitWidth="69.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../images/0b26ee1a6a4103dd9e329067b1e9c907.jpg" />
         </image>
      </ImageView>
   </children>
</AnchorPane>
