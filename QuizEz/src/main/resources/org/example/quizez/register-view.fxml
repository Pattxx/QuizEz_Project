<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.quizez.RegisterViewController">
   <children>
      <Label layoutX="249.0" layoutY="91.0" text="Stwórz nowe konto" />
      <TextField fx:id="UsernameInputField" layoutX="227.0" layoutY="175.0" promptText="Nazwa użytkownika" />
      <PasswordField fx:id="PasswordInputField" layoutX="227.0" layoutY="210.0" promptText="Hasło" />
      <PasswordField fx:id="RepeatPasswordInputField" layoutX="227.0" layoutY="247.0" promptText="Potwórz hasło" />
      <Button fx:id="CreateAccButton" layoutX="258.0" layoutY="312.0" mnemonicParsing="false" onAction="#onCreateAccButtonClick" text="Stwórz konto" />
      <Button fx:id="GoBackButton" layoutX="27.0" layoutY="20.0" mnemonicParsing="false" onAction="#onGoBackAccClick" text="Cofnij" />
      <Label fx:id="ErrorLabel" layoutX="255.0" layoutY="46.0" text="RegisterErrorInfo" textFill="RED" visible="false" />
   </children>
</AnchorPane>
