<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefWidth="1280.0" prefHeight="720.0" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.quizez.controllers.ProfilController" stylesheets="@../../../css/style.css">

   <children>
      <VBox spacing="25" alignment="TOP_CENTER" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="50" AnchorPane.rightAnchor="50" AnchorPane.bottomAnchor="20" style="-fx-padding: 10 20 10 20;">

         <Label fx:id="Nazwa" text="Nazwa Użytkownika">
            <font><Font size="20"/></font>
         </Label>

         <HBox spacing="60" alignment="TOP_CENTER" maxWidth="800" >

            <VBox spacing="15" alignment="CENTER_LEFT" prefWidth="350" maxWidth="350">
               <Label text="Rozegrane Quizy:">
                  <font><Font size="18"/></font>
               </Label>
               <Label fx:id="LiczbaQuiz" text="liczba">
                  <font><Font size="18"/></font>
               </Label>
               <Label text="Średni wynik:">
                  <font><Font size="18"/></font>
               </Label>
               <Label fx:id="SredniWynik" text="liczba">
                  <font><Font size="18"/></font>
               </Label>
            </VBox>

            <VBox spacing="15" alignment="TOP_LEFT" prefWidth="400" maxWidth="400">
               <Label text="Historia">
                  <font><Font size="18"/></font>
               </Label>
               <VBox fx:id="Quizy" prefHeight="200" prefWidth="400" style="-fx-border-color: gray; -fx-padding: 8; -fx-background-color: #f9f9f9;" />
            </VBox>
         </HBox>

         <HBox spacing="20" alignment="CENTER" maxWidth="600">
            <Label text="Stare hasło" minWidth="120" alignment="CENTER_RIGHT">
               <font><Font size="16"/></font>
            </Label>
            <PasswordField fx:id="Password1" prefWidth="250" maxWidth="250"/>
         </HBox>

         <HBox spacing="20" alignment="CENTER" maxWidth="600">
            <Label text="Nowe hasło" minWidth="120" alignment="CENTER_RIGHT">
               <font><Font size="16"/></font>
            </Label>
            <PasswordField fx:id="Password2" prefWidth="250" maxWidth="250"/>
         </HBox>

         <Button onAction="#onChangePasswordClick" prefWidth="160" text="Zmień hasło" />

         <Label fx:id="ErrorLabel" textFill="red" style="-fx-font-size: 14;" />

         <SplitMenuButton mnemonicParsing="false" prefHeight="60" prefWidth="160" text="Icon" onAction="#onNewIcon">
            <items>
               <MenuItem fx:id="Pies" mnemonicParsing="false" text="Pies" onAction="#onNewIcon"/>
               <MenuItem fx:id="Kot" mnemonicParsing="false" text="Kot" onAction="#onNewIcon"/>
               <MenuItem fx:id="Ryba" mnemonicParsing="false" text="Ryba" onAction="#onNewIcon"/>
               <MenuItem fx:id="Golab" mnemonicParsing="false" text="Gołąb" onAction="#onNewIcon"/>
            </items>
            <graphic>
               <ImageView fx:id="Icon" fitHeight="50" fitWidth="70" pickOnBounds="true" preserveRatio="true" />
            </graphic>
         </SplitMenuButton>

         <Button mnemonicParsing="false" onAction="#onWyloguj" prefHeight="35" prefWidth="120" text="Wyloguj" />

      </VBox>
      <Button mnemonicParsing="false" onAction="#onReturnClick" prefHeight="40" prefWidth="120" text="Powrót" />

   </children>
</AnchorPane>
